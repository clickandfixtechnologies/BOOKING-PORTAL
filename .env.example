# Server-side Supabase Edge Function secrets (set with `supabase secrets set`, never commit values)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
ALLOWED_ORIGIN=https://booking.clickandfix.site
PUBLIC_SITE_URL=https://booking.clickandfix.site
ADMIN_URL=https://booking.clickandfix.site/admin/
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=appointments@booking.clickandfix.site
VAPID_PUBLIC_KEY=replace_with_public_key
VAPID_PRIVATE_KEY=replace_with_private_key
VAPID_CONTACT_EMAIL=admin@booking.clickandfix.site
OTP_HASH_PEPPER=generate_a_long_random_secret_and_keep_server_side_only
# Browser configuration: copy js/app-config.js and use only the public URL and anon key.
# Never place SUPABASE_SERVICE_ROLE_KEY here.
